<div class="container {% unless page and page.handle == 'contactos-embalagem' %}container--narrow{% endunless %}">
  {% unless page and page.handle == 'contactos-embalagem' %}
    <header class="page__header page__header--centered">
      <h1 class="page__title heading h1">{{ page.title }}</h1>
    </header>
  {% endunless %}

  <div class="page__content rte">
    {{ page.content }}
  </div>
</div>
