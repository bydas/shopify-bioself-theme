{% assign hero_image = section.settings.image %}

<style>
  #afiliados-hero-{{ section.id }} {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: {{ section.settings.background_color }};
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__content {
    display: grid;
    align-content: center;
    padding: 4rem 2rem 4rem var(--desktop-container-gutter);
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__content-inner {
    display: grid;
    gap: 12px;
    width: min(100%, 620px);
  }

  #afiliados-hero-{{ section.id }} h1,
  #afiliados-hero-{{ section.id }} h2,
  #afiliados-hero-{{ section.id }} p {
    margin: 0;
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__title {
    color: {{ section.settings.heading_color }};
    font-family: var(--font-heading-family, var(--heading-font-family));
    font-size: clamp(36px, 3vw, 50px);
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__accent {
    color: {{ section.settings.accent_color }};
    font-family: var(--font-heading-family, var(--heading-font-family));
    font-size: clamp(28px, 2.1vw, 36px);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__description {
    max-width: 640px;
    margin-top: 8px;
    color: {{ section.settings.text_color }};
    font-size: clamp(18px, 1.35vw, 23px);
    line-height: 1.35;
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__image-wrapper {
    min-height: 336px;
  }

  #afiliados-hero-{{ section.id }} .afiliados-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 1499px) {
    #afiliados-hero-{{ section.id }} .afiliados-hero__content {
      padding-left: 9vw;
    }
  }

  @media screen and (min-width: 2559px) {
    #afiliados-hero-{{ section.id }} .afiliados-hero__content {
      padding-left: 18vw;
    }
  }

  @media screen and (max-width: 1000px) {
    #afiliados-hero-{{ section.id }} {
      grid-template-columns: minmax(0, 1fr);
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__image-wrapper {
      order: 1;
      min-height: 0;
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__image {
      height: auto;
      aspect-ratio: 345 / 188;
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__content {
      order: 2;
      justify-items: center;
      padding: 2rem var(--mobile-container-gutter);
      text-align: center;
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__content-inner {
      justify-items: center;
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__title {
      font-size: 32px;
      line-height: 1.1;
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__accent {
      font-size: 24px;
    }

    #afiliados-hero-{{ section.id }} .afiliados-hero__description {
      font-size: 16px;
      line-height: 1.5;
    }
  }
</style>

<section id="afiliados-hero-{{ section.id }}" class="afiliados-hero">
  <div class="afiliados-hero__content">
    <div class="afiliados-hero__content-inner">
      {% if section.settings.heading != blank %}
        <h1 class="afiliados-hero__title">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.accent_heading != blank %}
        <h2 class="afiliados-hero__accent">{{ section.settings.accent_heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="afiliados-hero__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="afiliados-hero__image-wrapper">
    {% if hero_image != blank %}
      {{
        hero_image
        | image_url: width: 1800
        | image_tag:
          class: 'afiliados-hero__image',
          widths: '480, 720, 960, 1200, 1500, 1800',
          sizes: '(max-width: 1000px) 100vw, 50vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_image.alt | default: section.settings.heading
      }}
    {% else %}
      <img
        class="afiliados-hero__image"
        src="{{ 'afiliados-hero.png' | asset_url }}"
        width="345"
        height="188"
        loading="eager"
        fetchpriority="high"
        alt="{{ section.settings.heading | escape }}"
      >
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Afiliados - Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Programa de Afiliados"
    },
    {
      "type": "text",
      "id": "accent_heading",
      "label": "Título em destaque",
      "default": "Embaixadores"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descrição",
      "default": "<p>Inspira a tua comunidade, promove o bem-estar e transforma a tua influência em rendimento.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#eff5ef"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Cor do título",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor do destaque",
      "default": "#258439"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Afiliados - Hero"
    }
  ]
}
{% endschema %}
