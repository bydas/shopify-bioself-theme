<section
  class="consultation-banner"
  style="--banner-green: {{ section.settings.background_color }}; --banner-yellow: {{ section.settings.offer_background_color }}; --banner-text: {{ section.settings.text_color }}; --banner-offer-text: {{ section.settings.offer_text_color }};"
>
  {% capture banner_content %}
    <div class="consultation-banner__media">
      {% if section.settings.image_desktop != blank %}
        {{
          section.settings.image_desktop
          | image_url: width: 1000
          | image_tag:
            widths: '320, 480, 640, 800, 1000',
            sizes: '(min-width: 1001px) 16vw, calc(100vw - 2rem)',
            class: 'consultation-banner__image',
            loading: 'lazy',
            alt: section.settings.image_alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'consultation-banner__placeholder' }}
      {% endif %}
    </div>

    <div class="consultation-banner__copy">
      {% if section.settings.heading != blank or section.settings.highlighted_heading != blank %}
        <h2 class="consultation-banner__heading">
          {% if section.settings.heading != blank %}
            <span>{{ section.settings.heading | escape }}</span>
          {% endif %}
          {% if section.settings.highlighted_heading != blank %}
            <strong>{{ section.settings.highlighted_heading | escape }}</strong>
          {% endif %}
        </h2>
      {% endif %}

      {% if section.settings.fine_print != blank %}
        <p class="consultation-banner__fine-print consultation-banner__fine-print--desktop">{{ section.settings.fine_print | escape }}</p>
      {% endif %}
    </div>

    <div class="consultation-banner__offer">
      <div class="consultation-banner__offer-main">
        {% if section.settings.discount_value != blank %}
          <p class="consultation-banner__discount" aria-label="{{ section.settings.discount_value | append: section.settings.discount_suffix | escape }}">
            <span>{{ section.settings.discount_value | escape }}</span><sup>{{ section.settings.discount_suffix | escape }}</sup>
          </p>
        {% endif %}

        {% if section.settings.offer_text != blank %}
          <p class="consultation-banner__offer-text">{{ section.settings.offer_text | escape | newline_to_br }}</p>
        {% endif %}
      </div>

      {% if section.settings.fine_print != blank %}
        <p class="consultation-banner__fine-print consultation-banner__fine-print--mobile">{{ section.settings.fine_print | escape }}</p>
      {% endif %}
    </div>
  {% endcapture %}

  {% if section.settings.link != blank %}
    <a class="consultation-banner__card" href="{{ section.settings.link }}">
      {{ banner_content }}
    </a>
  {% else %}
    <div class="consultation-banner__card">
      {{ banner_content }}
    </div>
  {% endif %}

  {% if section.settings.button_label != blank %}
    <div class="consultation-banner__button-wrapper">
      <a
        class="consultation-banner__button"
        href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif section.settings.link != blank %}{{ section.settings.link }}{% else %}#{% endif %}"
      >
        {{ section.settings.button_label | escape }}
      </a>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .consultation-banner {
    display: grid;
    gap: 28px;
    margin: 56px var(--desktop-container-gutter);
  }

  .consultation-banner__card {
    display: grid;
    grid-template-columns: 18% 37% 45%;
    width: 100%;
    max-width: 100%;
    min-height: 148px;
    overflow: hidden;
    border-radius: 9px;
    background: var(--banner-green);
    color: var(--banner-text);
    text-decoration: none;
  }

  .consultation-banner__media {
    width: 86%;
    height: 100%;
    min-height: 148px;
    overflow: hidden;
    border-radius: 0 999px 999px 0;
  }

  .consultation-banner__image,
  .consultation-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .consultation-banner__placeholder {
    background: rgba(255, 255, 255, 0.12);
  }

  .consultation-banner__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(14px, 1.6vw, 20px) clamp(20px, 2.5vw, 32px) clamp(14px, 1.6vw, 20px) 12px;
  }

  .consultation-banner__heading {
    max-width: 360px;
    margin: 0;
    color: inherit;
    font-family: "Red Hat Display", sans-serif;
    font-size: clamp(22px, 2.35vw, 30px);
    line-height: 1.3;
    font-weight: 900;
    letter-spacing: 0;
  }

  .consultation-banner__heading span,
  .consultation-banner__heading strong {
    display: block;
  }

  .consultation-banner__heading strong {
    width: fit-content;
    font-weight: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--banner-yellow);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.15em;
    text-decoration-skip-ink: auto;
  }

  .consultation-banner__offer {
    display: grid;
    align-content: center;
    gap: 3px;
    min-width: 0;
    padding: clamp(12px, 1.25vw, 16px) clamp(18px, 2vw, 28px) clamp(10px, 1.1vw, 14px) clamp(40px, 5vw, 64px);
    border-radius: 999px 0 0 999px;
    background: var(--banner-yellow);
    color: var(--banner-offer-text);
  }

  .consultation-banner__offer-main {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 1.6vw, 20px);
    min-width: 0;
  }

  .consultation-banner__discount,
  .consultation-banner__offer-text,
  .consultation-banner__fine-print {
    margin: 0;
  }

  .consultation-banner__discount {
    display: flex;
    align-items: center;
    color: var(--banner-green);
    font-family: "Red Hat Display", sans-serif;
    font-size: clamp(72px, 8.3vw, 105.28px);
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .consultation-banner__discount sup {
    align-self: center;
    margin-top: 0.08em;
    margin-left: 0.12em;
    font-size: 0.48em;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .consultation-banner__offer-text {
    max-width: 100%;
    min-width: 0;
    font-family: "Red Hat Display", sans-serif;
    font-size: clamp(18px, 2.3vw, 29.55px);
    line-height: 1.3;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .consultation-banner__fine-print {
    width: 100%;
    font-family: "Red Hat Display", sans-serif;
    font-size: clamp(12px, 1.25vw, 16px);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0;
  }

  .consultation-banner__fine-print--desktop {
    margin-top: 14px;
    color: var(--banner-text);
    text-align: left;
  }

  .consultation-banner__fine-print--mobile {
    display: none;
    text-align: center;
  }

  .consultation-banner__button-wrapper {
    display: flex;
    justify-content: center;
  }

  .consultation-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 13px 32px;
    border-radius: 6px;
    background: var(--banner-green);
    color: #ffffff;
    font-size: 15px;
    line-height: 1;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .consultation-banner__button:hover {
    color: #ffffff;
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .consultation-banner__card:focus-visible,
  .consultation-banner__button:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (min-width: 1499px) {
    .consultation-banner {
      margin-inline: 9vw;
    }
  }

  @media screen and (min-width: 2559px) {
    .consultation-banner {
      margin-inline: 18vw;
    }
  }

  @media screen and (max-width: 1000px) {
    .consultation-banner {
      gap: clamp(18px, 6.4vw, 24px);
      margin: clamp(28px, 10.67vw, 40px) var(--mobile-container-gutter);
    }

    .consultation-banner__card {
      grid-template-columns: 1fr;
      grid-template-rows: clamp(64px, 18.67vw, 70px) minmax(clamp(150px, 42.67vw, 160px), auto) minmax(clamp(108px, 30.93vw, 116px), auto);
      min-height: clamp(322px, 92.27vw, 346px);
      border-radius: 0;
    }

    .consultation-banner__media {
      width: 100%;
      min-height: clamp(64px, 18.67vw, 70px);
      border-radius: 0 0 clamp(36px, 11.73vw, 44px) clamp(36px, 11.73vw, 44px);
    }

    .consultation-banner__copy {
      align-items: center;
      justify-content: center;
      padding: clamp(20px, 6.4vw, 24px) clamp(18px, 7.47vw, 28px) clamp(16px, 5.33vw, 20px);
      text-align: center;
    }

    .consultation-banner__heading {
      max-width: 290px;
      font-size: clamp(22px, 6.4vw, 24px);
      line-height: 1.2;
    }

    .consultation-banner__heading strong {
      width: auto;
    }

    .consultation-banner__offer {
      align-content: start;
      gap: clamp(4px, 1.6vw, 6px);
      padding: clamp(11px, 3.73vw, 14px) clamp(16px, 7.47vw, 28px) clamp(6px, 1.87vw, 7px);
      border-radius: 999px 999px 0 0;
    }

    .consultation-banner__offer-main {
      gap: clamp(8px, 3.2vw, 12px);
    }

    .consultation-banner__discount {
      font-size: clamp(48px, 14.9vw, 55.88px);
      line-height: 1.2;
    }

    .consultation-banner__offer-text {
      max-width: none;
      font-size: clamp(13px, 4.18vw, 15.68px);
      line-height: 1.3;
      white-space: nowrap;
    }

    .consultation-banner__fine-print--desktop {
      display: none;
    }

    .consultation-banner__fine-print--mobile {
      display: block;
      font-size: clamp(10px, 3.2vw, 12px);
      line-height: 1.3;
    }

    .consultation-banner__button {
      width: 100%;
      min-height: 46px;
      padding: 14px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consultation-banner__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner de consulta (Novo)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagem"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo da imagem",
      "info": "Descreva a imagem para leitores de ecrã."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Transforme a sua saúde com o nosso"
    },
    {
      "type": "text",
      "id": "highlighted_heading",
      "label": "Título destacado",
      "default": "Acompanhamento em Nutrição Funcional"
    },
    {
      "type": "text",
      "id": "discount_value",
      "label": "Valor do desconto",
      "default": "20"
    },
    {
      "type": "text",
      "id": "discount_suffix",
      "label": "Símbolo do desconto",
      "default": "%"
    },
    {
      "type": "textarea",
      "id": "offer_text",
      "label": "Texto da oferta",
      "default": "DESCONTO NA\n1ª CONSULTA\nDE NUTRIÇÃO"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Texto de apoio",
      "default": "Campanha válida de 18/09 a 31/10 de 2026."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do banner"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Marque consulta e aproveite o desconto"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#24963f"
    },
    {
      "type": "color",
      "id": "offer_background_color",
      "label": "Cor de fundo da oferta",
      "default": "#ffc800"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do título",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "offer_text_color",
      "label": "Cor do texto da oferta",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Banner de consulta (Novo)",
      "category": "custom"
    }
  ]
}
{% endschema %}
