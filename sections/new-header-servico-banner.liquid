{% assign article_cta_image_height_auto = '100%' %}
{% assign article_cta_image_height_small = '400px' %}
{% assign article_cta_image_height_medium = '550px' %}
{% assign article_cta_image_height_large = '700px' %}

{% case section.settings.image_height %}
  {% when 'auto' %}
    {% assign article_cta_image_height = article_cta_image_height_auto %}
  {% when 'small' %}
    {% assign article_cta_image_height = article_cta_image_height_small %}
  {% when 'medium' %}
    {% assign article_cta_image_height = article_cta_image_height_medium %}
  {% when 'large' %}
    {% assign article_cta_image_height = article_cta_image_height_large %}
  {% else %}
    {% assign article_cta_image_height = article_cta_image_height_medium %}
{% endcase %}

{% assign article_cta_image = section.settings.image %}
{% assign article_cta_heading_font_bold = settings.heading_font | font_modify: 'weight', 'bolder' %}

{% if article_cta_image == blank and article.image != blank %}
  {% assign article_cta_image = article.image %}
{% endif %}

<style>
  {% if article_cta_heading_font_bold %}
    {{ article_cta_heading_font_bold | font_face: font_display: 'swap' }}
  {% endif %}

  #article-cta-hero-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: {{ section.settings.background_color }};
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__content {
    display: grid;
    align-content: center;
    gap: 2rem;
    padding: 4rem 2rem 4rem var(--desktop-container-gutter);
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__blocks {
    display: grid;
    gap: 1rem;
    max-width: 620px;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__block {
    display: grid;
    justify-items: start;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__title {
    font-family: var(--font-heading-family, var(--heading-font-family));
    font-size: 2.5rem;
    line-height: 1.15;
    margin: 0;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__subtitle {
    font-family: var(--font-heading-family, var(--heading-font-family));
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 0;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__description {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__description p {
    margin: 0;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 0.9rem 1.6rem;
    border-radius: {{ section.settings.button_radius }}px;
    line-height: 1;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__button:hover {
    opacity: 0.85;
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__image-wrapper {
    width: 100%;
    height: {{ article_cta_image_height }};
  }

  #article-cta-hero-{{ section.id }} .article-cta-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 1499px) {
    #article-cta-hero-{{ section.id }} .article-cta-hero__content {
      padding-left: 9vw;
    }
  }

  @media screen and (min-width: 2559px) {
    #article-cta-hero-{{ section.id }} .article-cta-hero__content {
      padding-left: 18vw;
    }
  }

  @media screen and (min-width: 1001px) {
    #article-cta-hero-{{ section.id }} .article-cta-hero__blocks {
      max-width: 720px;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__title {
      font-size: 3.1rem;
      line-height: 1.05;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__subtitle {
      font-size: 1.85rem;
      line-height: 1.2;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__description {
      font-size: 1.35rem;
      line-height: 1.55;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__button {
      font-size: 1rem;
      padding: 1.05rem 1.9rem;
    }
  }

  @media screen and (max-width: 1000px) {
    #article-cta-hero-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__image-wrapper {
      order: 1;
      height: auto;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__image {
      height: auto;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__content {
      order: 2;
      padding: 2rem var(--mobile-container-gutter);
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__block {
      text-align: center;
      justify-items: center;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__blocks {
      gap: 1rem;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__title {
      font-size: 32px !important;
      line-height: 1.1;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__subtitle {
      font-size: 24px !important;
      line-height: 1.2;
    }

    #article-cta-hero-{{ section.id }}
      .article-cta-hero__block--heading
      + .article-cta-hero__block--heading {
      margin-top: -8px !important;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__description {
      font-size: 16px !important;
      line-height: 1.6;
    }

    #article-cta-hero-{{ section.id }} .article-cta-hero__button {
      font-size: 15px !important;
    }
  }
</style>

<section id="article-cta-hero-{{ section.id }}" class="article-cta-hero">
  <div class="article-cta-hero__content">
    <div class="article-cta-hero__blocks">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.text != blank %}
              <div
                class="article-cta-hero__block article-cta-hero__block--heading"
                style="
                  margin-top: {{ block.settings.margin_top }}px;
                  margin-bottom: {{ block.settings.margin_bottom }}px;
                "
                {{ block.shopify_attributes }}
              >
                <h2
                  class="article-cta-hero__title"
                  style="
                    color: {{ block.settings.color }};
                    font-weight: {{ block.settings.font_weight }} !important;
                    {% if block.settings.font_size > 0 %}
                      font-size: {{ block.settings.font_size }}px;
                    {% endif %}
                  "
                >
                  {{ block.settings.text }}
                </h2>
              </div>
            {% endif %}

          {% when 'subheading' %}
            {% if block.settings.text != blank %}
              <div
                class="article-cta-hero__block"
                style="
                  margin-top: {{ block.settings.margin_top }}px;
                  margin-bottom: {{ block.settings.margin_bottom }}px;
                "
                {{ block.shopify_attributes }}
              >
                <h3
                  class="article-cta-hero__subtitle"
                  style="
                    color: {{ block.settings.color }};
                    font-weight: {{ block.settings.font_weight }} !important;
                    {% if block.settings.font_size > 0 %}
                      font-size: {{ block.settings.font_size }}px;
                    {% endif %}
                  "
                >
                  {{ block.settings.text }}
                </h3>
              </div>
            {% endif %}

          {% when 'description' %}
            {% if block.settings.text != blank %}
              <div
                class="article-cta-hero__block"
                style="
                  margin-top: {{ block.settings.margin_top }}px;
                  margin-bottom: {{ block.settings.margin_bottom }}px;
                "
                {{ block.shopify_attributes }}
              >
                <div
                  class="article-cta-hero__description"
                  style="
                    color: {{ block.settings.color }};
                    font-weight: {{ block.settings.font_weight }} !important;
                    {% if block.settings.font_size > 0 %}
                      font-size: {{ block.settings.font_size }}px;
                    {% endif %}
                  "
                >
                  {{ block.settings.text }}
                </div>
              </div>
            {% endif %}

          {% when 'button' %}
            {% if block.settings.label != blank %}
              <div
                class="article-cta-hero__block"
                style="
                  margin-top: {{ block.settings.margin_top }}px;
                  margin-bottom: {{ block.settings.margin_bottom }}px;
                "
                {{ block.shopify_attributes }}
              >
                <a
                  class="article-cta-hero__button"
                  href="{{ block.settings.link | default: '#' }}"
                  style="
                    color: {{ block.settings.text_color }};
                    background-color: {{ block.settings.background_color }};
                    font-weight: {{ block.settings.font_weight }} !important;
                    {% if block.settings.font_size > 0 %}
                      font-size: {{ block.settings.font_size }}px;
                    {% endif %}
                  "
                >
                  {{ block.settings.label }}
                </a>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {% if article_cta_image != blank %}
    <div class="article-cta-hero__image-wrapper">
      <img
        class="article-cta-hero__image"
        src="{{ article_cta_image | image_url: width: 1600 }}"
        alt="Nutricionista Dra. Rita de Cássia Silva no gabinete de consultas de nutrição"
        width="{{ article_cta_image.width }}"
        height="{{ article_cta_image.height }}"
        loading="eager"
      >
    </div>
  {% endif %}
</section>

