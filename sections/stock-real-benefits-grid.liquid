{{ 'stock-real-component-benefits-grid.css' | asset_url | stylesheet_tag }}
<section class="benefits-grid benefits-grid--{{ section.settings.layout }}{% if section.settings.mobile_layout == 'inline' %} benefits-grid--mobile-inline{% endif %}" style="{% if section.settings.background_color != blank %}--benefits-background: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}--benefits-text: {{ section.settings.text_color }};{% elsif section.settings.background_color != blank %}--benefits-text: var(--primary-button-text-color);{% endif %}{% if section.settings.heading_color != blank %}--benefits-heading-color: {{ section.settings.heading_color }};{% endif %}--benefits-text-align: {{ section.settings.text_alignment | default: 'center' }}; --benefits-columns: {{ section.settings.columns }}; --benefits-column-gap: {{ section.settings.column_gap | default: 20 }}px; --benefits-row-gap: {{ section.settings.row_gap | default: 20 }}px; --benefits-padding-top: {{ section.settings.padding_top }}px; --benefits-padding-bottom: {{ section.settings.padding_bottom }}px; --benefits-padding-left: {{ section.settings.padding_left }}px; --benefits-padding-right: {{ section.settings.padding_right }}px;">
  <div class="benefits-grid__panel{% if section.settings.panel %} benefits-grid__panel--framed{% endif %}">
  {% if section.settings.heading != blank or section.settings.description != blank %}
    <div class="benefits-grid__intro">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="rte">{% render 'stock-real-localized-content', content: section.settings.description %}</div>{% endif %}
    </div>
  {% endif %}
  <div class="benefits-grid__items">
    {% for block in section.blocks %}
      <article class="benefits-grid__item" {{ block.shopify_attributes }}>
        <div class="benefits-grid__icon" aria-hidden="true">{% render 'stock-real-icon', name: block.settings.icon, size: 48, display_variant: true %}</div>
        {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape | newline_to_br }}</h3>{% endif %}
        {% if block.settings.text != blank %}<div class="rte">{% render 'stock-real-localized-content', content: block.settings.text %}</div>{% endif %}
        {% if block.settings.button_label != blank %}<a class="benefits-grid__button benefits-grid__button--item" href="{% assign localized_link_url = block.settings.button_link | default: '#' %}{% render 'stock-real-localized-url', url: localized_link_url %}">{{ block.settings.button_label | escape }}</a>{% endif %}
      </article>
    {% endfor %}
  </div>
  {% if section.settings.button_label != blank %}<a class="benefits-grid__button" href="{% assign localized_link_url = section.settings.button_link | default: '#' %}{% render 'stock-real-localized-url', url: localized_link_url %}">{{ section.settings.button_label | escape }}</a>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Stock Real — Benefícios",
  "max_blocks": 12,
  "enabled_on": {
    "templates": [
      "index",
      "page",
      "product",
      "collection",
      "blog",
      "article",
      "metaobject"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Benefícios"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descrição",
      "default": "<p>Destaca as vantagens dos teus produtos ou serviços.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alinhamento do conteúdo",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Esquerda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Apresentação",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cartões"
        },
        {
          "value": "plain",
          "label": "Simples"
        },
        {
          "value": "strip",
          "label": "Faixa de benefícios"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "panel",
      "label": "Mostrar painel com contorno",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no computador",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Espaço horizontal das grelhas",
      "info": "Controla a distância entre colunas em desktop. Em tablet e telemóvel, o espaçamento horizontal é limitado ao valor responsivo do tema.",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Espaço vertical das grelhas",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Ligação do botão"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding à esquerda",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding à direita",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Disposição em mobile",
      "options": [
        {
          "value": "stacked",
          "label": "Centrado"
        },
        {
          "value": "inline",
          "label": "Ícone ao lado do texto"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Cor dos títulos"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "inventory_2",
          "options": [
            {
              "value": "delivery_truck_speed",
              "label": "Entrega"
            },
            {
              "value": "bolt",
              "label": "Energia"
            },
            {
              "value": "inventory_2",
              "label": "Stock"
            },
            {
              "value": "schedule",
              "label": "Tempo de espera"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Benefício"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Descreve um benefício e explica o que o torna valioso.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Ligação do botão"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grelha de benefícios",
      "category": "Benefícios",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "paid"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cookie"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "redeem"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support_agent"
          }
        }
      ]
    },
    {
      "name": "Benefícios num painel com contorno",
      "category": "Benefícios",
      "settings": {
        "layout": "plain",
        "panel": true,
        "columns": 3
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle"
          }
        }
      ]
    },
    {
      "name": "Texto com ícones",
      "category": "Benefícios",
      "settings": {
        "layout": "strip",
        "columns": 3,
        "heading": "",
        "description": ""
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "delivery_truck_speed"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "paid"
          }
        }
      ]
    },
    {
      "name": "Benefícios de serviços",
      "category": "Benefícios",
      "settings": {
        "layout": "cards",
        "columns": 3,
        "text_alignment": "start",
        "heading": "Descubra os nossos serviços",
        "description": "<p>Partilhe informação útil com os seus clientes.</p>"
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle",
            "button_label": "Saber mais"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle",
            "button_label": "Saber mais"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "check_circle",
            "button_label": "Saber mais"
          }
        }
      ]
    }
  ]
}
{% endschema %}
