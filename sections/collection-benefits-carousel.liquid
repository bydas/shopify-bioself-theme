{% liquid
  assign carousel_id = 'benefit-collections-' | append: section.id
%}
<section id="{{ carousel_id }}" class="benefit-collections" style="--space-top: {{ section.settings.padding_top }}px; --space-bottom: {{ section.settings.padding_bottom }}px">
  <div class="benefit-collections__inner">
    {% if section.settings.heading != blank %}
      <h2 class="benefit-collections__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="benefit-collections__stage">
      <button class="benefit-collections__arrow benefit-collections__arrow--prev" type="button" aria-label="Ver coleções anteriores" aria-controls="{{ carousel_id }}-track" hidden><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M15 18 9 12l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <ul id="{{ carousel_id }}-track" class="benefit-collections__track" tabindex="0" aria-label="Coleções">
        {% for block in section.blocks %}
          {% assign chosen_collection = block.settings.collection %}
          {% assign card_image = block.settings.image | default: chosen_collection.image %}
          {% assign card_title = chosen_collection.title | default: 'Coleção' %}
          <li class="benefit-collections__item" {{ block.shopify_attributes }}>
            {% if chosen_collection != blank %}<a class="benefit-collections__card" href="{{ chosen_collection.url }}" aria-label="{{ card_title | escape }}">{% else %}<div class="benefit-collections__card benefit-collections__card--empty">{% endif %}
              {% if card_image != blank %}
                {{ card_image | image_url: width: 900 | image_tag: class: 'benefit-collections__image', loading: 'lazy', alt: card_title, widths: '320, 480, 640, 900', sizes: '(min-width: 1000px) 17vw, (min-width: 700px) 30vw, 72vw' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'benefit-collections__image' }}
              {% endif %}
              <span class="benefit-collections__shade" style="opacity: {{ block.settings.overlay_opacity | default: 100 | divided_by: 100.0 }}" aria-hidden="true"></span>
              <span class="benefit-collections__content">
                <span class="benefit-collections__title">{{ card_title | escape }}</span>
                {% if block.settings.subtitle != blank %}<span class="benefit-collections__subtitle">{{ block.settings.subtitle | escape | newline_to_br }}</span>{% endif %}
                <span class="benefit-collections__cta"><span class="benefit-collections__cta-default">{{ block.settings.button_text | default: 'Explorar' | escape }}</span><span class="benefit-collections__cta-hover">{{ section.settings.hover_button_text | escape }}</span></span>
              </span>
            {% if chosen_collection != blank %}</a>{% else %}</div>{% endif %}
          </li>
        {% endfor %}
      </ul>
      <button class="benefit-collections__arrow benefit-collections__arrow--next" type="button" aria-label="Ver mais coleções" aria-controls="{{ carousel_id }}-track" hidden><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </div>
</section>
