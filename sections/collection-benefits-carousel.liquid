  }
  @media(prefers-reduced-motion:reduce){#{{ carousel_id }} .benefit-collections__image,#{{ carousel_id }} .benefit-collections__cta{transition:none}}
@media(max-width:1599px) and (min-width:1000px){#{{ carousel_id }} .benefit-collections__heading{font-size:24px}}@media(max-width:999px){#{{ carousel_id }} .benefit-collections__heading{font-size:16px}}</style>
<script>
  (()=>{
    const root=document.getElementById('{{ carousel_id }}');
    if(!root)return;
    const track=root.querySelector('.benefit-collections__track');
    const prev=root.querySelector('.benefit-collections__arrow--prev');
    const next=root.querySelector('.benefit-collections__arrow--next');
    const update=()=>{
      const overflow=track.scrollWidth>track.clientWidth+2;
      const mobile=matchMedia('(max-width:699px)').matches;
      prev.hidden=mobile||!overflow||track.scrollLeft<2;
      next.hidden=mobile||!overflow||track.scrollLeft+track.clientWidth>=track.scrollWidth-2;
    };
    const step=()=>track.querySelector('.benefit-collections__item')?.getBoundingClientRect().width+parseFloat(getComputedStyle(track).gap)||track.clientWidth;
    prev.addEventListener('click',()=>track.scrollBy({left:-step(),behavior:'smooth'}));
    next.addEventListener('click',()=>track.scrollBy({left:step(),behavior:'smooth'}));
    track.addEventListener('scroll',update,{passive:true});
    new ResizeObserver(update).observe(track);
    update();
  })();
</script>
{% schema %}
{
  "name": "t:bioself.home.benefit_carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:bioself.home.heading",
      "default": "t:bioself.home.heading_default"
    },
    {
      "type": "text",
      "id": "hover_button_text",
      "label": "t:bioself.home.hover_button_text",
      "default": "t:bioself.home.hover_button_text_default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:bioself.home.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:bioself.home.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "t:bioself.home.collection_card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:bioself.home.card_image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:bioself.home.card_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:bioself.home.card_collection"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "t:bioself.home.card_subtitle"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:bioself.home.card_button_text",
          "default": "t:bioself.home.card_button_text_default"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:bioself.home.benefit_carousel",
      "category": "t:categories.collections",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}