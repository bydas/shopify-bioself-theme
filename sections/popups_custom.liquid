{% if request.design_mode or section.settings.enabled and customer.accepts_marketing != true %}
  {{ 'component-newsletter-popup.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'popup-motion.js' | asset_url }}" defer></script>
  <script src="{{ 'newsletter-popup.js' | asset_url }}" defer></script>
  {% render 'newsletter-popup-modern', section: section %}
{% endif %}

{% schema %}
{
  "name": "t:newsletter_dialog.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:newsletter_dialog.enabled",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:newsletter_dialog.image"
    },
    {
      "type": "richtext",
      "id": "termos",
      "label": "t:newsletter_dialog.terms"
    },
    {
      "type": "header",
      "content": "t:newsletter_dialog.integration"
    },
    {
      "type": "paragraph",
      "content": "t:newsletter_dialog.info"
    },
    {
      "type": "text",
      "id": "klaviyo_site_id",
      "label": "t:newsletter_dialog.site"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "t:newsletter_dialog.list"
    },
    {
      "type": "select",
      "id": "preview_state",
      "label": "t:newsletter_dialog.preview",
      "info": "t:newsletter_dialog.preview_info",
      "default": "initial",
      "options": [
        {
          "value": "initial",
          "label": "t:newsletter_dialog.states.initial"
        },
        {
          "value": "focus",
          "label": "t:newsletter_dialog.states.focus"
        },
        {
          "value": "email_required",
          "label": "t:newsletter_dialog.states.email_required"
        },
        {
          "value": "email_invalid",
          "label": "t:newsletter_dialog.states.email_invalid"
        },
        {
          "value": "terms_required",
          "label": "t:newsletter_dialog.states.terms_required"
        },
        {
          "value": "combined",
          "label": "t:newsletter_dialog.states.combined"
        },
        {
          "value": "sending",
          "label": "t:newsletter_dialog.states.sending"
        },
        {
          "value": "failed",
          "label": "t:newsletter_dialog.states.failed"
        },
        {
          "value": "pending",
          "label": "t:newsletter_dialog.states.pending"
        },
        {
          "value": "pending_no_shortcut",
          "label": "t:newsletter_dialog.states.pending_no_shortcut"
        },
        {
          "value": "edit",
          "label": "t:newsletter_dialog.states.edit"
        },
        {
          "value": "confirmed",
          "label": "t:newsletter_dialog.states.confirmed"
        },
        {
          "value": "invalid",
          "label": "t:newsletter_dialog.states.invalid"
        },
        {
          "value": "already",
          "label": "t:newsletter_dialog.states.already"
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
