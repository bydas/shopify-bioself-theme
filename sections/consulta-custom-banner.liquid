<style>
  .custom-banner {
    display: grid;
    grid-auto-rows: max-content;
    grid-auto-flow: row;
    gap: 16px;
    margin: 56px var(--desktop-container-gutter);
  }

  .custom-banner__media,
  .custom-banner__media picture {
    display: block;
    width: 100%;
  }

  .custom-banner__media img {
    width: 100%;
    display: block;
    object-fit: cover;
    border-radius: 8px;
  }

  .custom-banner__button-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .custom-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 13px 32px;
    border-radius: 5px;
    background-color: #23843c;
    color: #ffffff;
    font-size: 15px;
    line-height: 1;
    font-weight: 900 !important;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .custom-banner__button:hover {
    color: #ffffff;
    opacity: 0.9;
    transform: translateY(-1px);
  }

  @media screen and (min-width: 1499px) {
    .custom-banner {
      margin: 56px 9vw;
    }
  }

  @media screen and (min-width: 2559px) {
    .custom-banner {
      margin: 56px 18vw;
    }
  }

  @media screen and (max-width: 1000px) {
    .custom-banner {
      gap: 1.5rem;
      margin: 40px var(--mobile-container-gutter);
    }

    .custom-banner__media img {
      border-radius: 0.65rem;
    }

    .custom-banner__button {
      width: 100%;
      min-height: 46px;
      padding: 14px 18px;
    }
  }
</style>

<section class="custom-banner">
  {% if section.settings.use_prescribed_campaign_banner or section.settings.image_desktop != blank %}
    {% capture banner_media %}
      <picture>
        {% if section.settings.use_prescribed_campaign_banner %}
          <source
            media="(max-width: 768px)"
            srcset="{{ 'consulta-nutricao-banner-mobile.png' | asset_url }}"
          >
          <img
            src="{{ 'consulta-nutricao-banner-desktop.png' | asset_url }}"
            alt="{{ section.settings.image_alt | default: 'Desconto de 20% na primeira consulta de nutrição' | escape }}"
            width="2048"
            height="323"
            loading="eager"
          >
        {% else %}
          {% if section.settings.image_mobile != blank %}
            <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
          {% endif %}

          <img
            src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
            alt="{{ section.settings.image_alt | default: section.settings.button_label | escape }}"
            width="{{ section.settings.image_desktop.width }}"
            height="{{ section.settings.image_desktop.height }}"
            loading="eager"
          >
        {% endif %}
      </picture>
    {% endcapture %}

    {% if section.settings.link != blank %}
      <a class="custom-banner__media" href="{{ section.settings.link }}">
        {{ banner_media }}
      </a>
    {% else %}
      <div class="custom-banner__media">
        {{ banner_media }}
      </div>
    {% endif %}
  {% endif %}

  {% if section.settings.button_label != blank %}
    <div class="custom-banner__button-wrapper">
      <a
        class="custom-banner__button"
        href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif section.settings.link != blank %}{{ section.settings.link }}{% else %}#{% endif %}"
      >
        {{ section.settings.button_label }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Banner Customizado",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_prescribed_campaign_banner",
      "label": "Usar banner da campanha sem data",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagem de fundo desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagem de fundo mobile"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do bloco"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt da imagem"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    }
  ],
  "presets": [
    {
      "name": "Banner Customizado",
      "category": "custom"
    }
  ]
}
{% endschema %}
